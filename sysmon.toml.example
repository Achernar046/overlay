# ตัวอย่าง config ของ sysmon (ไว้ที่ working directory ของโปรแกรม ชื่อ sysmon.toml)

sample_interval_ms = 1000

[collector]
monitor_disks = true
monitor_networks = true
monitor_temps = true
monitor_nvidia = true

[storage]
enabled = true
db_path = "sysmon.db"
flush_secs = 15        # เขียนลง DB ทุก 10-30 วิ ตาม plan
retention_raw_hours = 24
